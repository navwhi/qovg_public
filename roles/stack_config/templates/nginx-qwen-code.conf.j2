# {{ ansible_managed }}

server {
    listen 443 ssl;
    server_name app.{{ qwen_domain }};
    ssl_certificate     /etc/nginx/ssl/qwen-code.crt;
    ssl_certificate_key /etc/nginx/ssl/qwen-code.key;
    location / {
        proxy_pass http://open-webui:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 600s;
    }
}

server {
    listen 443 ssl;
    server_name api.{{ qwen_domain }};
    ssl_certificate     /etc/nginx/ssl/qwen-code.crt;
    ssl_certificate_key /etc/nginx/ssl/qwen-code.key;
    location / {
        # No LiteLLM in the lite version: straight to vLLM (no per-user keys or quotas).
        proxy_pass http://vllm:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 600s;
    }
}

server {
    listen 443 ssl;
    server_name grafana.{{ qwen_domain }};
    ssl_certificate     /etc/nginx/ssl/qwen-code.crt;
    ssl_certificate_key /etc/nginx/ssl/qwen-code.key;
    location / {
        proxy_pass http://grafana:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 80;
    server_name app.{{ qwen_domain }} api.{{ qwen_domain }} grafana.{{ qwen_domain }};
    return 301 https://$host$request_uri;
}

# ------------------------------------------------------------------
# Internal company PKI (disabled) — to switch to a signed certificate,
# replace qwen-code.crt / qwen-code.key with the signed certificate
# (+ full chain) and its key. These server{} blocks stay unchanged.
# See roles/tls_selfsigned/tasks/main.yml for the detailed steps.
# ------------------------------------------------------------------
